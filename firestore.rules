rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidDownloadItem(data) {
      return data.keys().hasAll(['id', 'uid', 'name', 'isAudio', 'createdAtMs', 'createdAt'])
        && data.keys().hasOnly(['id', 'uid', 'name', 'enName', 'isAudio', 'sourceUrl', 'platform', 'sizeText', 'createdAtMs', 'createdAt'])
        && data.id is string
        && isValidId(data.id)
        && data.id.size() <= 64
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && (!('enName' in data) || (data.enName is string && data.enName.size() <= 160))
        && data.isAudio is bool
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 1000))
        && (!('platform' in data) || (data.platform is string && data.platform.size() <= 40))
        && (!('sizeText' in data) || (data.sizeText is string && data.sizeText.size() <= 32))
        && (data.createdAtMs is int || data.createdAtMs is float)
        && data.createdAtMs >= 0
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // Isolated PII user profile (strictly single 'info' document per verified user)
    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && docId == 'info';
      allow list: if false;
      allow create: if isOwner(userId) && docId == 'info' && isValidUserProfile(incoming());
      allow update: if isOwner(userId)
        && docId == 'info'
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId) && docId == 'info';
    }

    // Synced per-user download history records
    match /users/{userId}/downloads/{downloadId} {
      allow get: if isOwner(userId) && isValidId(downloadId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(downloadId)
        && incoming().id == downloadId
        && isValidDownloadItem(incoming());
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(downloadId);
    }
  }
}
